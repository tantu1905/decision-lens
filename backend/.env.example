# Copy to backend/.env and fill in. Empty values: the local stand-ins answer (no Azure needed).

# Database: SQLite locally, or Azure SQL, e.g. Server=tcp:xxx.database.windows.net,1433;Database=decisionlens;Uid=...;Pwd=...
DB_CONNECTION_STRING=

# Azure AI Foundry resource (Microsoft Agent Framework): its endpoint, e.g. https://<name>.services.ai.azure.com,
# the GPT deployment name and one of the resource's keys. No az login.
FOUNDRY_ENDPOINT=
FOUNDRY_MODEL=
FOUNDRY_API_KEY=
# A smaller GPT deployment (e.g. GPT-6 Luna) for the Match Storyteller and Fan feed, which only write text from
# finished results. Empty: they use FOUNDRY_MODEL too.
FOUNDRY_LIGHT_MODEL=

# Microsoft Decision-1 (text only): usually the same resource endpoint and key, deployment name as in Foundry.
# Keys live only here or in the app's settings, never in the code.
DECISION1_ENDPOINT=
DECISION1_DEPLOYMENT=Decision-1
DECISION1_API_KEY=

# Azure Blob Storage (empty: files go to LOCAL_STORAGE_DIR)
BLOB_CONNECTION_STRING=
BLOB_CONTAINER=decision-lens
LOCAL_STORAGE_DIR=

# Agent calls at the same time (Foundry rate limit)
MAX_PARALLEL=8

# Logging: console (local) or azure (Application Insights: logs, traces and the agents' own spans)
LOGGING_MODE=console
APPLICATIONINSIGHTS_CONNECTION_STRING=
DEPLOYMENT_ENVIRONMENT=development
AGENT_TELEMETRY_MODE=critical

LOAD_SAMPLE_ON_START=true
